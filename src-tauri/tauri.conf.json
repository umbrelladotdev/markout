{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markout",
  "version": "0.2.0",
  "identifier": "dev.umbrella.markout",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Markout",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Markout est un éditeur Markdown local : aperçu Mermaid, export PDF et Word avec diagrammes rendus, table des matières, 100 % hors ligne.",
    "shortDescription": "Markdown → aperçu Mermaid → PDF & Word",
    "copyright": "Markout",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "installMode": "both",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    }
  }
}
